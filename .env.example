# Server-only. The API gateway the BFF forwards to (inside the cluster: http://gateway).
GATEWAY_URL=http://localhost:8080
# Google Identity Services web client ID (same project as the mobile clients).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public origin, used for share links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Content-Security-Policy origins (scheme + host). Default "https:" allows any HTTPS
# origin; set these in production to lock media and uploads to your own hosts.
NEXT_PUBLIC_MEDIA_ORIGIN=https://cdn.lumo.app
NEXT_PUBLIC_UPLOAD_ORIGIN=https://lumo-media.r2.cloudflarestorage.com
